START
    PUSHI 0
    PUSHI 0
    PUSHI 10
    STOREG 0
    PUSHG 0
    PUSHI -1
    MUL
    STOREG 1
    PUSHS "A = "
    WRITES
    PUSHG 0
    WRITEI
    WRITELN
    PUSHS "-A = "
    WRITES
    PUSHG 1
    WRITEI
    WRITELN
    PUSHG 0
    PUSHI -1
    MUL
    PUSHI 5
    ADD
    STOREG 1
    PUSHS "-A + 5 = "
    WRITES
    PUSHG 1
    WRITEI
    WRITELN
STOP
