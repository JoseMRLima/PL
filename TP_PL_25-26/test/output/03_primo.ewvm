START
    PUSHI 0
    PUSHI 0
    PUSHI 0
    PUSHS "Introduza um numero inteiro positivo:"
    WRITES
    WRITELN
    READ
    ATOI
    STOREG 0
    PUSHI 1
    STOREG 2
    PUSHI 2
    STOREG 1
l20:
    PUSHG 1
    PUSHG 0
    PUSHI 2
    DIV
    INFEQ
    PUSHG 2
    AND
    JZ ifelse1
    PUSHG 0
    PUSHG 1
    MOD
    PUSHI 0
    EQUAL
    JZ ifelse3
    PUSHI 0
    STOREG 2
    JUMP ifend4
ifelse3:
ifend4:
    PUSHG 1
    PUSHI 1
    ADD
    STOREG 1
    JUMP l20
    JUMP ifend2
ifelse1:
ifend2:
    PUSHG 2
    JZ ifelse5
    PUSHG 0
    WRITEI
    PUSHS " e um numero primo"
    WRITES
    WRITELN
    JUMP ifend6
ifelse5:
    PUSHG 0
    WRITEI
    PUSHS " nao e um numero primo"
    WRITES
    WRITELN
ifend6:
STOP
